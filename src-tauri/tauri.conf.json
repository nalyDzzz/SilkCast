{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SilkCast",
  "version": "0.3.0",
  "identifier": "dev.nalyd.silkcast",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SilkCast",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/mpv/windows"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGQzIxRDgyNUE0RkY5NDUKUldSRitVOWFnaDNDdjJPMXN2OFJsTEpISFg4dlBSOGRXdmJRQnBMM05qTmIzMm5QMzRNQWRSSlUK",
      "endpoints": [
        "https://github.com/nalyDzzz/SilkCast/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
